# Public application URL used for canonical URLs, sitemap, robots, and metadata.
# In production, use your buyer-owned HTTPS domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase browser/server client configuration.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only secrets. Never expose these as NEXT_PUBLIC_* variables.
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=

# Optional AI Editorial helper — basic RSS import works without these.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
