# Public application URL used for canonical URLs, sitemap, robots, and metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Appwrite public project configuration.
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=6abd3aa6000db661c656

# Appwrite database configuration.
APPWRITE_DATABASE_ID=infohub
APPWRITE_CATEGORIES_TABLE_ID=categories
APPWRITE_ARTICLES_TABLE_ID=articles
APPWRITE_ARTICLE_CATEGORIES_TABLE_ID=article_categories
APPWRITE_TAGS_TABLE_ID=tags
APPWRITE_ARTICLE_TAGS_TABLE_ID=article_tags
APPWRITE_PROFILES_TABLE_ID=profiles
APPWRITE_AUDIT_LOGS_TABLE_ID=audit_logs
APPWRITE_SOURCES_TABLE_ID=sources
APPWRITE_INGESTION_RUNS_TABLE_ID=ingestion_runs
APPWRITE_NOTIFICATIONS_TABLE_ID=notifications

# Optional server-side Appwrite API key for privileged CMS operations.
APPWRITE_API_KEY=

# Existing server-only configuration.
CRON_SECRET=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
