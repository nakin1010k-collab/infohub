{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm install",
  "buildCommand": "next build",
  "outputDirectory": ".next",
  "git": {
    "deploymentEnabled": {
      "feature/**": false
    }
  },
  "crons": [
    {
      "path": "/api/cron/ingest",
      "schedule": "30 2 * * *"
    }
  ]
}
